    {"path": "ems_interventions", "kind": "list", "expect": [["c-spine", "cspine", "immobiliz", "backboard"], ["iv", "large bore"]], "weight": 3},
    {"path": "ems_interventions", "kind": "not_contains", "expect": ["saline", "lactated", "improved"], "weight": 2,
     "note": "fluid type and any response were never stated"},
    {"path": "assessment_findings.breathing", "kind": "contains", "expect": ["diminished", "right"], "weight": 2},
    {"path": "assessment_findings.other_findings", "kind": "list",
     "expect": [["scalp", "laceration"], ["forearm", "fracture"], ["seatbelt", "abdom"]], "weight": 2},
    {"path": "hospital_recommendations.activation_requested", "kind": "contains", "expect": ["trauma"], "weight": 2},
    {"path": "hospital_recommendations.suggested_destination", "kind": "enum", "expect": "Trauma Bay", "weight": 3}
  ]
