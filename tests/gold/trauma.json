{
  "case": "trauma",
  "fields": [
    {"path": "alert_type", "kind": "enum", "expect": "TRAUMA", "weight": 3},
    {"path": "alert_level", "kind": "enum", "expect": "RED", "weight": 3},
    {"path": "patient.age", "kind": "int", "expect": 34, "weight": 2},
    {"path": "patient.sex", "kind": "enum", "expect": "Female", "weight": 2},
    {"path": "eta_minutes", "kind": "int", "expect": 6, "weight": 2},
    {"path": "vital_signs.blood_pressure", "kind": "contains", "expect": ["88/60"], "weight": 2},
    {"path": "vital_signs.heart_rate", "kind": "int", "expect": 124, "weight": 2},
    {"path": "vital_signs.respiratory_rate", "kind": "int", "expect": 28, "weight": 2},
    {"path": "vital_signs.spo2", "kind": "contains", "expect": ["91"], "weight": 2},
    {"path": "vital_signs.spo2", "kind": "contains", "expect": ["non-rebreather", "nrb", "15"], "weight": 2},
    {"path": "vital_signs.gcs", "kind": "gcs", "expect": 13, "breakdown": [3, 4, 6], "weight": 3},
