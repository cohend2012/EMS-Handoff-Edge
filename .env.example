# HANDOFF.AI settings. Copy to .env and fill in what you use.
# .env is git-ignored: keys never go into the code or the repo.

# --- AI that writes the report: groq | ollama | openrouter -------------------
HANDOFF_PROVIDER=groq
# The Groq key is NOT set here. Set it once for every copy of the app with:
#     bash scripts/set_groq_key.sh       (saves to ~/.config/handoff-ai/secrets.env)
# OPENROUTER_API_KEY=
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b            # needs ~7.3 GB free; the app falls back to a pulled smaller model (qwen3:4b-instruct, ...) when it does not fit.
#                                  # On an 8 GB Jetson pull qwen3:4b-instruct, not qwen3:4b: that tag is the thinking variant and times out.
# HANDOFF_LLM_TIMEOUT_S=180

# --- final transcript: auto | groq | local ------------------------------------
# auto = Groq Whisper when GROQ_API_KEY is set (fast), otherwise local Whisper (offline)
HANDOFF_TRANSCRIBER=auto
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# LOCAL_WHISPER_MODEL=large-v3-turbo   # smaller/faster on CPU: small.en, base.en
# LOCAL_WHISPER_DEVICE=cpu
# LOCAL_WHISPER_COMPUTE=int8

# --- live listening -------------------------------------------------------------
# Mic: blank = auto (first USB input). Or a device number, or part of its name (safer: names do not change).
HANDOFF_MIC_DEVICE=
# HANDOFF_CAPTIONS=auto              # auto | vosk | whisper | off
# VOSK_MODEL_DIR=models/vosk-model-small-en-us-0.15
# HANDOFF_STOP_PHRASE=confirm report ready
# HANDOFF_MAX_RECORDING_S=600

# --- app ---------------------------------------------------------------------------
# HANDOFF_PORT=5050               # the old EMS-Handoff app uses 5000
# HANDOFF_USE_TEXTBOOK_RAG=1
